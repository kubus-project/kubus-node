{
  "name": "@kubus/kubus-node",
  "version": "0.8.0-alpha.4",
  "description": "Local runtime and public archive node for art.kubus",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "kubus-node": "./dist/src/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts start",
    "start": "node dist/src/index.js start",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.check.json",
    "status": "tsx src/index.ts status",
    "doctor": "tsx src/index.ts doctor",
    "gui": "tsx src/index.ts gui",
    "smoke": "tsx scripts/smoke.ts",
    "sync:version": "node scripts/sync_version.mjs",
    "sync:versions": "npm run sync:version",
    "build:release-package": "node scripts/build_release_package.mjs",
    "verify:release-package": "node scripts/verify_release_package.mjs"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "json-stable-stringify": "1.3.0",
    "node-datachannel": "^0.33.1",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "socket.io-client": "4.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/qrcode": "^1.5.5",
    "@zxing/library": "^0.21.3",
    "sharp": "^0.35.3",
    "tsx": "4.23.12",
    "typescript": "^5.7.3",
    "vitest": "4.1.10"
  }
}
