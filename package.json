{
  "name": "@kubus/kubus-node",
  "version": "0.8.0",
  "description": "Local runtime and public archive node for art.kubus",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "kubus-node": "./dist/src/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts start",
    "start": "node dist/src/index.js start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "status": "tsx src/index.ts status",
    "doctor": "tsx src/index.ts doctor",
    "gui": "tsx src/index.ts gui",
    "smoke": "tsx scripts/smoke.ts",
    "sync:version": "node scripts/sync_version.mjs",
    "sync:versions": "npm run sync:version"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "json-stable-stringify": "1.3.0",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "tsx": "4.23.12",
    "typescript": "^5.7.3",
    "vitest": "4.1.10"
  }
}
