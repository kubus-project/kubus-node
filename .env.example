KUBUS_API_BASE_URL=https://api.kubus.site
KUBUS_OPERATOR_TOKEN=kubus_node_replace_with_scoped_operator_token
KUBUS_OPERATOR_WALLET=0x0000000000000000000000000000000000000000
KUBUS_NODE_LABEL=kubus-node-1
KUBUS_NODE_ENDPOINT_URL=http://127.0.0.1:8080
IPFS_RPC_URL=http://kubo:5001
IPFS_GATEWAY_URL=http://127.0.0.1:8080
LOCAL_STATE_PATH=/var/lib/kubus-node/state.json
LOG_LEVEL=info
HEARTBEAT_INTERVAL_MS=60000
CID_SYNC_INTERVAL_MS=300000
COMMITMENT_INTERVAL_MS=900000
STATUS_INTERVAL_MS=120000
MAX_PINNED_CIDS=100
MAX_PINNED_BYTES=53687091200
# Caps the public pin set mirrored locally. Class filters only apply to records that declare a class.
CID_CLASS_FILTERS=hot,warm
NODE_ENV=development

# Optional
KUBUS_NODE_KEY=
KUBUS_AUTH_MODE=bearer
KUBUS_DEV_SEED_CID=
KUBUS_DEV_ALLOW_EMPTY_CIDS=true
KUBUS_SKIP_PINNING=false
KUBUS_VERIFIER_ENDPOINT_URL=

# Local operator GUI
NODE_GUI_ENABLED=true
NODE_GUI_HOST=0.0.0.0
NODE_GUI_PORT=8787
NODE_GUI_TOKEN=change-this-local-gui-password
NODE_GUI_ALLOW_REMOTE=false
NODE_GUI_DISPLAY_URL=http://my.node.kubus.site:8787/gui

# Local device API. LAN clients are rejected unless explicitly enabled.
LOCAL_API_ENABLED=true
LOCAL_API_HOST=0.0.0.0
LOCAL_API_PORT=8787
LOCAL_API_ALLOW_LAN=false
# Optional phone-reachable endpoints. The Node API itself can remain loopback
# bound behind a reverse proxy/tunnel. Remote access is HTTPS-only.
LOCAL_API_LAN_URL=http://192.168.1.20:8787
LOCAL_API_REMOTE_URL=
PAIRING_SESSION_TTL_MS=300000
LOCAL_DATA_PATH=/var/lib/kubus-node/data
JOB_CONCURRENCY=1
PARTICIPATION_GRACE_MS=900000

# Optional worker; Compose's spatial profile provides this service.
SPATIAL_WORKER_URL=http://kubus-spatial-worker:8790
KUBUS_SPATIAL_MAX_ITERATIONS=15000

# Public archive participation is mandatory. Offering GPU capacity is optional.
OFFER_REMOTE_COMPUTE=false
REMOTE_COMPUTE_PAUSED=false
REMOTE_COMPUTE_MAX_CONCURRENCY=1
REMOTE_COMPUTE_MAX_QUEUE_DEPTH=2
REMOTE_COMPUTE_MAX_INPUT_BYTES=21474836480
REMOTE_COMPUTE_MINIMUM_FREE_VRAM_BYTES=2147483648
